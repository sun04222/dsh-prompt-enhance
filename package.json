{
  "name": "dsh-prompt-enhance",
  "version": "1.1.1",
  "description": "Prompt enhancement for DeepSeek Harness: a composer button and an enhance_prompt tool that rewrite a draft into a clearer, more specific prompt, following the same rules as WorkBuddy's enhance-prompt feature.",
  "type": "module",
  "main": "index.js",
  "exports": {
    ".": "./index.js",
    "./client": "./client.js",
    "./prompt": "./prompt.js",
    "./locale/*.json": "./locale/*.json",
    "./icon": "./icon.svg",
    "./package.json": "./package.json"
  },
  "files": [
    "index.js",
    "client.js",
    "prompt.js",
    "cordis.patch.yml",
    "locale/*.json",
    "icon.svg",
    "README.md",
    "LICENSE",
    "CHANGELOG.md",
    "THIRD_PARTY_NOTICES.md",
    "test/*.test.mjs"
  ],
  "keywords": [
    "dsh-plugin",
    "deepseek-harness",
    "prompt-engineering",
    "prompt-enhance",
    "composer"
  ],
  "author": "sun04222",
  "license": "MIT",
  "homepage": "https://github.com/sun04222/dsh-prompt-enhance#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/sun04222/dsh-prompt-enhance.git"
  },
  "bugs": {
    "url": "https://github.com/sun04222/dsh-prompt-enhance/issues"
  },
  "engines": {
    "node": ">=22"
  },
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web",
      "immediately": true,
      "inject": [
        "@deepseek-ai/dsh-client-ui-conversation",
        "@deepseek-ai/dsh-client-locale"
      ]
    }
  }
}